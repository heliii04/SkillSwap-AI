NODE_ENV=development
PORT=

CLIENT_URL=

MONGO_URI=
JWT_SECRET=

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

OTP_EXPIRES_IN_MINUTES=10
BCRYPT_SALT_ROUNDS=12

# for sending mail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=

MAIL_FROM_NAME=SkillSwap AI
MAIL_FROM_ADDRESS=
SMTP_FROM_EMAIL=

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web Push Notifications VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:support@skillswap.ai
E N C R Y P T I O N _ K E Y = 


# AI (optional) — every AI feature falls back to a rule-based result
# when these are missing, so the app works without a key.
# Works with any OpenAI-compatible endpoint:
#   OpenRouter -> https://openrouter.ai/api/v1  (model: openai/gpt-4o-mini)
#   OpenAI     -> https://api.openai.com/v1     (model: gpt-4o-mini)
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1 
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=20000
AI_CACHE_TTL_MINUTES=60
